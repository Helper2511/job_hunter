# Supabase Postgres
DATABASE_URL=                 # pooled connection string
DIRECT_URL=                   # direct connection string, used for migrations

# Better Auth
BETTER_AUTH_SECRET=           # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sign-in providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Resume storage (private bucket)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes

# Background jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Email
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_ADDRESS=        # verified sender for notifications
POSTMARK_INBOUND_SECRET=      # verifies the inbound webhook
INBOUND_EMAIL_DOMAIN=         # for example in.yourapp.com

# LLM (any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=                 # optional, for other OpenAI-compatible providers
LLM_MODEL=gpt-4.1-mini

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional licensed jobs-data aggregator
JOBS_DATA_API_KEY=
JOBS_DATA_API_URL=
